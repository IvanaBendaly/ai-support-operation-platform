NORTHSTAR_ENVIRONMENT=development
NORTHSTAR_DATABASE_URL=postgresql+psycopg://northstar:local-only-password@localhost:5432/northstar
NORTHSTAR_ALLOWED_ORIGINS=["http://localhost:5173"]
POSTGRES_DB=northstar
POSTGRES_USER=northstar
POSTGRES_PASSWORD=local-only-password
# Configuration references only; C01 never invokes a model.
NORTHSTAR_MODEL_PROVIDER=disabled
# Set both when configuring a provider (do not commit a real key):
# NORTHSTAR_MODEL_NAME=your-model-id
# NORTHSTAR_PROVIDER_API_KEY=
NORTHSTAR_MODEL_TIMEOUT_SECONDS=30
NORTHSTAR_MODEL_MAX_OUTPUT_TOKENS=1024

# Optional. Generate a private random token (at least 32 characters) to enable C03.
# NORTHSTAR_ADMIN_TOKEN=
