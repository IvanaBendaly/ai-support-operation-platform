NORTHSTAR_ENVIRONMENT=development
NORTHSTAR_DATABASE_URL=postgresql+psycopg://northstar:local-only-password@localhost:5432/northstar
NORTHSTAR_ALLOWED_ORIGINS=["http://localhost:5173"]
POSTGRES_DB=northstar
POSTGRES_USER=northstar
POSTGRES_PASSWORD=local-only-password
# Reserved support-workflow gateway configuration (separate from document review).
NORTHSTAR_MODEL_PROVIDER=disabled
# Set both when configuring a provider (do not commit a real key):
# NORTHSTAR_MODEL_NAME=your-model-id
# NORTHSTAR_PROVIDER_API_KEY=
NORTHSTAR_MODEL_TIMEOUT_SECONDS=30
NORTHSTAR_MODEL_MAX_OUTPUT_TOKENS=1024

# Optional. Generate a private random token (at least 32 characters) to enable C03.
# NORTHSTAR_ADMIN_TOKEN=

# C04 retrieval limits (also forwarded by Compose).
NORTHSTAR_RETRIEVAL__RESULT_LIMIT=5
NORTHSTAR_RETRIEVAL__CONTEXT_CHARS=8000
NORTHSTAR_RETRIEVAL__SECTION_CHARS=2000

# Local development only. Use private credentials and IAM roles in production.
MINIO_ROOT_USER=northstar-local
MINIO_ROOT_PASSWORD=local-minio-password-change-me
NORTHSTAR_STORAGE__ENDPOINT=http://127.0.0.1:9000
NORTHSTAR_STORAGE__BUCKET=northstar-originals
NORTHSTAR_STORAGE__ACCESS_KEY=northstar-local
NORTHSTAR_STORAGE__SECRET_KEY=local-minio-password-change-me
NORTHSTAR_STORAGE__RESTRICTED_ENVIRONMENT_APPROVED=false

# Review routing is fail-closed. See docs/DOCUMENT_REVIEW.md before enabling.
NORTHSTAR_REVIEW__PROVIDER=disabled
NORTHSTAR_REVIEW__OLLAMA_MODEL=qwen3:4b
NORTHSTAR_REVIEW__OLLAMA_URL=http://127.0.0.1:11434
NORTHSTAR_REVIEW__LOCAL_ENVIRONMENT_APPROVED=false
NORTHSTAR_REVIEW__RESTRICTED_LOCAL_APPROVED=false
NORTHSTAR_REVIEW__EXTERNAL_PUBLIC_ALLOWED=false
NORTHSTAR_REVIEW__EXTERNAL_INTERNAL_ALLOWED=false
NORTHSTAR_REVIEW__EXTERNAL_CONFIDENTIAL_EXCEPTION=false
NORTHSTAR_REVIEW__OPENAI_MODEL=gpt-4o-mini
# NORTHSTAR_REVIEW__OPENAI_API_KEY=
NORTHSTAR_REVIEW__TIMEOUT_SECONDS=60

# Extraction verification (BR-01 B2–B5). See docs/EXTRACTION_VERIFICATION.md.
# No confidence floor is assumed: leave unset until evaluated on representative examples.
NORTHSTAR_EXTRACTION__LITEPARSE_ENABLED=true
NORTHSTAR_EXTRACTION__MINIMUM_CHARACTERS=80
# NORTHSTAR_EXTRACTION__CONFIDENCE_FLOOR=
# Optional LlamaExtract field extraction. External processing is off for every level by default;
# Highly Restricted and unclassified documents can never be sent, whatever these flags say.
# NORTHSTAR_EXTRACTION__FIELD_SCHEMA={"type":"object","properties":{"policy_id":{"type":"string"}}}
# NORTHSTAR_EXTRACTION__FIELD_CONFIDENCE_FLOOR=
# NORTHSTAR_EXTRACTION__LLAMAEXTRACT_API_KEY=
# NORTHSTAR_EXTRACTION__LLAMAEXTRACT_PROJECT_ID=
NORTHSTAR_EXTRACTION__EXTERNAL_PUBLIC_ALLOWED=false
NORTHSTAR_EXTRACTION__EXTERNAL_INTERNAL_ALLOWED=false
NORTHSTAR_EXTRACTION__EXTERNAL_CONFIDENTIAL_EXCEPTION=false
